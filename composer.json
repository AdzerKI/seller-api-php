{
    "name": "opotopo/seller-api",
    "description": "Клиент Seller API ОПОТОПО на PHP: синхронизация позиций каталога, загрузка файлов, приём вебхуков и выдача данных покупок",
    "type": "library",
    "license": "MIT",
    "keywords": ["opotopo", "seller-api", "catalog", "marketplace", "psr-18"],
    "support": {
        "source": "https://github.com/AdzerKI/seller-api-php"
    },
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "standard-webhooks/standard-webhooks": "^1.0.2"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.3",
        "guzzlehttp/psr7": "^3.2",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Opotopo\\SellerApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Opotopo\\SellerApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
